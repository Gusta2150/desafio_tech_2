# Copie para .env e preencha. Nunca versione o .env.

# Provedor da LLM: offline | groq | ollama | openai | anthropic
LLM_PROVIDER=groq
# Modelo (opcional — cada provedor tem um padrão)
# groq: openai/gpt-oss-120b | ollama: llama3.1:8b | openai: gpt-4o-mini | anthropic: claude-haiku-4-5
LLM_MODEL=
# URL base (opcional). Ex.: Ollama em outra máquina: http://192.168.0.10:11434/v1
LLM_BASE_URL=
# Chave do provedor (ou use GROQ_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY)
LLM_API_KEY=

# Novas tentativas quando a API responde 429 (limite de taxa) ou erro temporário.
# O plano gratuito do Groq limita tokens por minuto; a espera segue o cabeçalho Retry-After.
LLM_MAX_RETRIES=5

# Esforço de raciocínio dos modelos gpt-oss (low | medium | high). Vazio = low nesses modelos:
# no nível padrão o raciocínio consome os tokens e o JSON da resposta às vezes sai cortado.
LLM_REASONING_EFFORT=

# Logs: json (produção) | text (terminal)
LOG_FORMAT=json
LOG_LEVEL=INFO

# Opcional: envia os experimentos também para um servidor MLflow
# MLFLOW_TRACKING_URI=http://localhost:5000
